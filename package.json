{
  "name": "retro-console",
  "version": "0.1.0",
  "private": true,
  "description": "Five original Nintendo-style browser games behind a retro console menu.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "phaser": "4.2.1"
  }
}
