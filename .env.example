# Copy this file to .env.local and adjust the values. .env.local is git-ignored.
#
# WARNING: every variable starting with VITE_ is bundled into the browser code,
# so anyone can read it. Never put passwords, API keys or tokens here.

# (Game 03, online play) Host of your own PeerJS signaling server.
# Leave empty to use the free public PeerJS cloud server.
VITE_PEER_HOST=
